# ==========================================
# SecurePDF AI v3.0 - Enterprise Environment Configuration
# ==========================================

# Core Application
PROJECT_NAME="SecurePDF AI Enterprise"
PROJECT_VERSION="3.0.0"
ENVIRONMENT="production"
DEBUG=false

# Security & Secrets (Must be at least 32 cryptographically random bytes)
SECRET_KEY="replace_with_enterprise_super_secret_cryptographic_key_32_bytes_minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Zero-Trust Ephemeral Containment
ZERO_TRUST_TEMP_DIR="/tmp/securepdf_ephemeral"
AUTO_WIPE_AFTER_SECONDS=1800
MAX_FILE_SIZE_MB=100

# Relational Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:enterprise_secure_postgres_pass@localhost:5432/securepdf_db"
USE_SQLITE_DEV=true

# Distributed Caching & Task Queues (Redis)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# AI & LLM Providers
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
DEFAULT_LLM_MODEL="deepseek-chat"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=1024
RERANKER_MODEL="BAAI/bge-reranker-large"

# Rate Limiting Controls
FREE_RATE_LIMIT_PER_MIN=5
FREE_HEAVY_JOBS_PER_DAY=3
PRO_RATE_LIMIT_PER_MIN=60
PRO_HEAVY_JOBS_PER_DAY=200
